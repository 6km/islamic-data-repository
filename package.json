		"@tailwindcss/vite": "^4.3.5",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^16.5.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
